# Settings for CI (ROADMAP 13.7) — .github/workflows/ci.yml loads this with
# DOTENV_CONFIG_PATH. Committed on purpose: every value is a PLACEHOLDER.
# Nothing here reaches a real service — tests mock email, Paystack, Meta,
# Gemini and Namecheap — and the database is a throwaway Postgres the workflow
# starts and builds from the migrations. Never put a real key in this file.

DATABASE_URL=postgresql://postgres:ci@localhost:5432/notely
DIRECT_URL=postgresql://postgres:ci@localhost:5432/notely

AUTH_SECRET=ci-placeholder-auth-secret-not-used-anywhere-real-0000
AUTH_URL=http://app.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=app.localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MOBILE_DOMAIN=m.app.localhost:3000

RESEND_API_KEY=re_ci_placeholder
EMAIL_FROM="Notely CI <ci@example.com>"
PLATFORM_ADMIN_EMAIL=staff@example.com

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ci-cloud
NEXT_PUBLIC_CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=ci-placeholder-cloudinary-secret

META_APP_ID=0000000000
META_APP_SECRET=ci-placeholder-meta-secret
META_REDIRECT_URI=http://app.localhost:3000/api/social/meta/callback
SOCIAL_TOKEN_KEY=ci-placeholder-social-token-key-0000000000000000

GOOGLE_CLIENT_ID=ci-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ci-placeholder

PAYSTACK_SECRET_KEY=sk_test_ci_placeholder
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_ci_placeholder

NAMECHEAP_SANDBOX=true
CRON_SECRET=ci-placeholder-cron-secret
