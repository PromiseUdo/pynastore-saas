# Copy to .env and fill in. See MOBILE.md for the mobile-specific vars.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
# The same database's DIRECT address (Neon host without "-pooler"), for
# migrations — they can't run through the pooler. On Vercel Production it also
# makes deploys apply pending migrations (scripts/db/migrate-on-deploy.mjs).
DIRECT_URL=
# Development only: an EMPTY scratch database `prisma migrate dev` replays
# history into (Prisma wipes it). docs/DATABASE.md has the setup.
SHADOW_DATABASE_URL=
# Connections per server instance (default 5 on Vercel, 10 elsewhere).
# DATABASE_POOL_MAX=

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
AUTH_SECRET=
# The platform origin. Local dev: http://app.localhost:3000
# Production:            https://app.getnotely.io
AUTH_URL=http://app.localhost:3000
# Authorized redirect URIs to register in the Google console:
#   {PLATFORM_HOST}/api/auth/callback/google            — staff sign-in
#   {OAUTH_ORIGIN}/api/storefront/auth/google/callback  — shopper sign-in
# The shopper one is a single fixed URI on purpose: every storefront
# (subdomain, custom domain, mobile origin) finishes its Google round trip
# there and is then handed back to its own origin, so no merchant ever needs
# a console entry of their own. See lib/storefront/account/google.ts.
#
# LOCALLY that URI is http://localhost:3000/api/storefront/auth/google/callback
# — NOT app.localhost. Google rejects a plain-http redirect URI unless the host
# is exactly `localhost` or `127.0.0.1`, so shopper sign-in runs the OAuth hop
# on bare localhost in development and hands the session to the store's own
# origin afterwards, exactly as it does in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override the origin that runs the shopper OAuth hop. Only needed if the
# default (the platform host in production, bare localhost in development)
# isn't the origin registered in the Google console. Set it explicitly in
# production so the value can never drift from the console entry.
# Production: https://app.getnotely.io
# STOREFRONT_OAUTH_ORIGIN=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── URLs / multi-tenancy ────────────────────────────────────────────────────
# The platform origin, used for links generated outside a request (password
# reset emails, billing callbacks). Must match AUTH_URL.
NEXT_PUBLIC_APP_URL=http://app.localhost:3000

# The domain every platform hostname hangs off, and the scope of the staff
# session cookie. NOT necessarily the host that serves the app — see
# NEXT_PUBLIC_PLATFORM_HOST below.
#
#   {ROOT_DOMAIN}             marketing
#   www.{ROOT_DOMAIN}         marketing
#   {PLATFORM_HOST}           platform / sign-in / OAuth callbacks
#   {slug}.{ROOT_DOMAIN}      tenant admin
#   shop-{slug}.{ROOT_DOMAIN} tenant storefront
#   m.{ROOT_DOMAIN}           mobile app origin
#
# Every one of those is a SINGLE label under {ROOT_DOMAIN}, so one wildcard
# certificate (*.{ROOT_DOMAIN}) covers the whole platform and a new tenant
# needs no DNS work. Production: getnotely.io
NEXT_PUBLIC_ROOT_DOMAIN=app.localhost:3000

# The host that serves marketing, sign-in and every OAuth callback.
# LEAVE BLANK in local development: it then falls back to
# NEXT_PUBLIC_ROOT_DOMAIN, which locally already is the platform host
# (app.localhost:3000), and nothing changes.
# In production it MUST be set, otherwise app.getnotely.io would be parsed as
# a tenant admin site for an organization called "app".
# Production: app.getnotely.io
NEXT_PUBLIC_PLATFORM_HOST=

# ─── AI shopping assistant ───────────────────────────────────────────────────
# Gemini API key (https://aistudio.google.com/apikey — free tier is fine).
# SERVER-SIDE ONLY: read by lib/ai/assistant/gemini/client.ts. Never rename it
# to NEXT_PUBLIC_…, never commit a real value. Gemini only interprets what the
# shopper asked; every product it shows comes from the store's own catalogue.
GEMINI_API_KEY=

# Which AIShoppingProvider serves the storefront assistant
# (lib/ai/assistant/service.ts): "gemini" or "mock" (deterministic, no network
# call). Leave unset to use gemini when GEMINI_API_KEY is set, mock otherwise.
# Even on gemini, a failure, a 429 or a spent budget answers with the mock's
# engine instead — the storefront never shows an AI error.
AI_SHOPPING_PROVIDER=

# Optional. Model id; default gemini-3.5-flash-lite (fast, free tier).
# GEMINI_MODEL=

# Optional. How many Gemini calls this server will make — keep them under your
# project's free-tier limits (AI Studio → Rate limits). The store caps stop one
# merchant's shoppers using up everyone's quota. Per instance: with several
# server instances, divide by the instance count.
# GEMINI_MAX_RPM=12
# GEMINI_MAX_RPD=900
# GEMINI_STORE_MAX_RPM=6
# GEMINI_STORE_MAX_RPD=250

# ─── Search by image (storefront visual search) ─────────────────────────────
# Uses the same GEMINI_API_KEY above, with Gemini's multimodal embedding model.
# Product photos are embedded once, stored in Postgres (pgvector), and every
# shopper search compares against those — see lib/storefront/visual-search/.
# Photos are indexed after each product save and by /api/cron/index-product-images
# (every 15 minutes; see docs/SCHEDULED-JOBS.md).
#
# Optional. The model (must accept images) — default gemini-embedding-2.
# Vectors are 768-dimensional (fixed by the database column).
# GEMINI_EMBEDDING_MODEL=
#
# Optional. Result tuning — cosine similarity 0–1. Defaults and why are in
# lib/storefront/visual-search/config.ts; tune with real shopper photos.
# VISUAL_SEARCH_MAX_RESULTS=24
# VISUAL_SEARCH_MIN_SIMILARITY=0.62
# VISUAL_SEARCH_GOOD_SIMILARITY=0.70
# VISUAL_SEARCH_STRONG_SIMILARITY=0.80
# VISUAL_SEARCH_RELATIVE_BAND=0.15
#
# Optional. Embedding-call budget, kept under your free-tier limits (AI Studio
# → Rate limits). Shopper searches and indexing share the global numbers;
# indexing has its own lower per-minute ceiling so shoppers always have room.
# GEMINI_EMBED_MAX_RPM=50
# GEMINI_EMBED_MAX_RPD=900
# GEMINI_EMBED_STORE_MAX_RPM=20
# GEMINI_EMBED_STORE_MAX_RPD=300
# GEMINI_EMBED_INDEX_MAX_RPM=30

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
# ONE Paystack account — the platform's — takes subscription billing AND every
# storefront payment. Merchants never supply keys: each approved shop gets a
# Paystack subaccount on this account, payments settle straight to the shop's
# bank less Paystack's fee (paid by the merchant), and the platform takes no
# share (docs/ROADMAP.md Phase 10). SERVER-SIDE ONLY: never rename it to
# NEXT_PUBLIC_…, never commit a real value.
#
# A sk_test_ key is Paystack's test mode (no real money); sk_live_ is live.
PAYSTACK_SECRET_KEY=

# Which mode this deployment expects: "live" or "test". When it disagrees with
# the key, nothing talks to Paystack at all — so a test key left on the live
# site can't mark real orders paid, and a live key on staging can't move real
# money. SET "live" IN PRODUCTION. Leave blank locally to follow the key.
PAYSTACK_MODE=

# In Paystack's dashboard (Settings → API Keys & Webhooks), for test AND live:
#   Webhook URL:  https://{PLATFORM_HOST}/api/payments/paystack/webhook
# (The older /api/billing/paystack/webhook serves the same handler.) There is
# no separate webhook secret: Paystack signs with the secret key above. The
# callback URL is set per transaction by the app and needs no dashboard entry.
#
# Test mode, in practice:
#   - /bank/resolve allows only 3 real-bank lookups a day. Use Zenith Bank
#     (code 057) with account 0000000000 — it resolves (as "Test") and can
#     receive a subaccount. Paystack's test bank 001 resolves but can't.
#   - Test card and OTP details: Paystack's "Test payments" docs page.

# Protects every /api/cron/* job (ROADMAP 13.1): callers must send
# "Authorization: Bearer $CRON_SECRET". Vercel Cron sends it by itself for the
# daily jobs in vercel.json; cron-job.org is given it for the two 15-minute
# jobs while we're on Vercel Hobby. Setup: docs/SCHEDULED-JOBS.md. Failures and
# jobs that stop running are emailed to PLATFORM_ADMIN_EMAIL.
CRON_SECRET=

# Rate limits and AI budgets are counted in the database, shared by every
# server instance (ROADMAP 13.2). Leave unset. "memory" keeps them per process
# (tests use that by default); "database" forces the shared store in tests.
# RATE_LIMIT_STORE=

# The error log (ROADMAP 13.3, docs/MONITORING.md) records only on the live
# site (VERCEL_ENV=production). "on" records anywhere, "off" nowhere. Alerts
# go to PLATFORM_ADMIN_EMAIL.
# ERROR_LOG=

# The Content Security Policy (ROADMAP 13.4, lib/security/csp.ts): "enforce"
# (default) blocks and reports; "report" only reports — flip to it if a live
# page breaks, then fix and flip back; "off" sends no policy.
# CSP_MODE=

# The phone app's deep-link scheme; must match ios/App/App/Info.plist and
# android/app/src/main/res/values/strings.xml (custom_url_scheme).
NEXT_PUBLIC_MOBILE_APP_SCHEME=com.mansaas.app

# ─── Domain registration (Namecheap) ─────────────────────────────────────────
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true
PLATFORM_ADMIN_EMAIL=
# Where merchants are told to write to us — e.g. on the "workspace suspended"
# page (ROADMAP 11.4). Falls back to PLATFORM_ADMIN_EMAIL when unset.
PLATFORM_SUPPORT_EMAIL=
# Where a merchant's own domain points (ROADMAP 12.6): the www CNAME target
# and the bare domain's A record, as the host gives them. Defaults are
# Vercel's (cname.vercel-dns.com / 76.76.21.21).
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_APEX_IP=

# ─── Capacitor mobile app ────────────────────────────────────────────────────
# Single-origin host for the storefront mobile app. Storefront pages are
# served here as /s/{slug}/...; admin/dashboard paths are blocked.
# Production: m.getnotely.io
NEXT_PUBLIC_MOBILE_DOMAIN=m.app.localhost:3000
# Deployed mobile origin used as Capacitor server.url for release builds.
# Blank = app shows the offline fallback. Build-time only: changing it needs a
# native rebuild and a store release before installed apps follow.
# Production: https://m.getnotely.io
NEXT_PUBLIC_MOBILE_URL=
# Set automatically by `cap run … --live-reload --external`.
# CAP_SERVER_URL=
#
# Mobile-app tier (see lib/mobile/app-config.ts). Unset = 'mall': one app,
# store picker at '/', every /s/{slug} reachable. The future premium tier is
# a per-merchant branded build: set both of these at build time so the app
# opens straight into one store with no picker.
# NEXT_PUBLIC_MOBILE_APP_MODE=branded
# NEXT_PUBLIC_MOBILE_APP_SLUG=

# ─── Social Commerce (Meta: Facebook Pages + Instagram) ──────────────────────
# ONE Meta app for the whole platform. Merchants never supply credentials —
# they authorise this app against their own Facebook account, and the platform
# stores the resulting per-store token (encrypted).
#
# Meta app setup: Business app, products "Facebook Login for Business" +
# "Instagram". Permissions needed (Advanced Access via App Review before
# merchants outside your testers can grant them):
#   pages_show_list, pages_read_engagement, pages_manage_posts,
#   instagram_basic, instagram_content_publish, business_management
META_APP_ID=
META_APP_SECRET=
# The single OAuth callback, registered in the Meta app under
# "Valid OAuth Redirect URIs". Meta matches it EXACTLY and allows no
# wildcard, so it cannot be a per-merchant subdomain — the store travels in
# the signed OAuth state instead. Leave blank to use
# https://{PLATFORM_HOST}/api/social/meta/callback.
# Local development needs an HTTPS tunnel; set it here.
# Production: https://app.getnotely.io/api/social/meta/callback
META_REDIRECT_URI=

# ─── Social Commerce (TikTok) — NOT REQUIRED ────────────────────────────────
# TikTok is a declared provider with no implementation yet
# (lib/social/providers/tiktok.ts documents what it needs). The app runs
# normally with these unset, and setting them does NOT enable TikTok.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=

# ─── Social Commerce (AI copy) — OPTIONAL ───────────────────────────────────
# Caption writing reuses GEMINI_API_KEY above; there is no second AI provider
# and no second key. These only resize the social-copy share of the Gemini
# budget, which is kept separate from the shopper-facing assistant and visual
# search so a merchant writing captions can never use up the quota that
# answers customers. Defaults are in lib/ai/social/quota.ts.
# GEMINI_SOCIAL_MAX_RPM=10
# GEMINI_SOCIAL_MAX_RPD=500
# GEMINI_SOCIAL_STORE_MAX_RPM=6
# GEMINI_SOCIAL_STORE_MAX_RPD=150

# Encrypts stored social access tokens (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
# Required in production. Unset falls back to a key derived from AUTH_SECRET,
# which is fine for development but means rotating AUTH_SECRET would make
# every stored token unreadable.
SOCIAL_TOKEN_KEY=
